.env

# Python
.venv/
__pycache__/
.ipynb_checkpoints/

# Download metadata huggingface_hub writes beside scripts/download_data.py's output
.cache/

# Fetched source trees. Regenerable on demand from data/repos.json (every
# entry is pinned, so a checkout is reproducible), and carrying their own
# upstream licences — so never committed. `src/repos.py` extracts a tarball
# rather than cloning, so no .git lands here either.
data/checkouts/

# The Kissane et al. deployment-resource bundle: eleven upstream repos plus
# their prompt and tool collections, gigabytes in total, and reproducible from
# the commit `src/kissane_replication/kissane_resources.py` pins.
data/kissane_resources/

# The dataset: audit logs and benchmark collections, downloaded from Hugging
# Face by scripts/download_data.py (see README "Data").
logs/
data/transcripts/
